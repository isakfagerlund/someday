{
  "name": "someday",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate:local": "wrangler d1 migrations apply someday --local",
    "test": "vitest run",
    "types": "wrangler types",
    "types:check": "wrangler types --check",
