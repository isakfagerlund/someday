{
  "manifest_version": 3,
  "name": "Save to someday",
  "version": "0.1.0",
  "description": "Save a product from the current page to your someday board.",
  "permissions": ["activeTab"],
  "action": {
    "default_title": "Save to someday",
    "default_icon": "icon-32.png"
  },
  "icons": {
    "32": "icon-32.png",
    "192": "icon-192.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
